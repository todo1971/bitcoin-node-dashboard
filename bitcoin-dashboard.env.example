DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787
DASHBOARD_CACHE_SECONDS=10
BITCOIN_CLI=/home/btc/bin/bitcoin-cli
BITCOIN_DATADIR=/home/btc/bitcoin-data
BITCOIN_COOKIE=/home/btc/bitcoin-core/.bitcoin/.cookie
PUBLIC_NODE_ADDRESS=217.160.16.224
PUBLIC_NODE_PORT=8333
EXTERNAL_CACHE_SECONDS=300
DATABASE_PATH=/var/lib/bitcoin-dashboard/history.sqlite3
SAMPLE_INTERVAL_SECONDS=60
HISTORY_RETENTION_DAYS=365
MEMPOOL_ANALYSIS_SECONDS=300
UTXO_SAMPLE_SECONDS=86400
VERSION_CHECK_SECONDS=21600
ALERT_EMAIL=
ALERT_WEBHOOK_URL=
ALERT_GRACE_SECONDS=300
ALERT_NO_INBOUND_SECONDS=900
ALERT_COOLDOWN_SECONDS=21600
SYNC_LAG_BLOCKS=3
DISK_MAX_USED_PERCENT=90
MEMORY_MAX_USED_PERCENT=90
ADMIN_TOKEN=
DASHBOARD_GITHUB_REPOSITORY=todo1971/bitcoin-node-dashboard
# Fine-grained GitHub token with read-only Contents access; required for private repositories.
DASHBOARD_GITHUB_TOKEN=
BITCOIN_UPLOAD_DIR=/var/lib/bitcoin-dashboard/bitcoin-core-upload
BITCOIN_UPLOAD_MAX_BYTES=209715200
