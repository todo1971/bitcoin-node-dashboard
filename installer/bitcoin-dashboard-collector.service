[Unit]
Description=Read-only Bitcoin dashboard collector
After=network-online.target bitcoind.service
Wants=network-online.target

[Service]
Type=simple
User=bitcoin-dashboard
Group=bitcoin-dashboard
WorkingDirectory=/opt/bitcoin-dashboard
EnvironmentFile=/var/lib/bitcoin-dashboard/.env
Environment=ADMIN_UPDATES_ENABLED=0
Environment=ADMIN_TOKEN=
ExecStart=/usr/bin/python3 -I /opt/bitcoin-dashboard/app.py
Restart=on-failure
RestartSec=5
StateDirectory=bitcoin-dashboard
StateDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/bitcoin-dashboard
ProtectControlGroups=true
MemoryMax=768M
TasksMax=128

[Install]
WantedBy=multi-user.target
