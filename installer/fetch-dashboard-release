#!/usr/bin/env python3
"""Download and verify the newest dashboard release from GitHub."""

from __future__ import annotations

import hashlib
import json
import os
import re
import sys
import tempfile
import urllib.error
import urllib.request
from pathlib import Path

ENV_FILE = Path("/etc/default/bitcoin-dashboard")
UPDATER_CONFIG = Path("/etc/bitcoin-dashboard-updater.conf")
MAX_ARCHIVE_BYTES = 50 * 1024 * 1024
MAX_CHECKSUM_BYTES = 4096
USER_AGENT = "BitcoinNodeDashboard-Updater/1.6"


def read_env(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return values
    for line in lines:
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        if re.fullmatch(r"[A-Z][A-Z0-9_]*", key):
            values[key] = value.strip().strip('"').strip("'")
    return values


def version_tuple(value: str) -> tuple[int, ...]:
    match = re.fullmatch(r"v?(\d+\.\d+\.\d+)", value.strip())
    if not match:
        raise ValueError(f"Ungültiger Release-Tag: {value!r}")
    return tuple(int(part) for part in match.group(1).split("."))


def request_bytes(url: str, token: str, accept: str, maximum: int) -> bytes:
    headers = {"Accept": accept, "User-Agent": USER_AGENT}
    if token:
        headers["Authorization"] = f"Bearer {token}"
        headers["X-GitHub-Api-Version"] = "2022-11-28"
    request = urllib.request.Request(url, headers=headers)
    with urllib.request.urlopen(request, timeout=30) as response:
        data = response.read(maximum + 1)
    if len(data) > maximum:
        raise ValueError("GitHub-Datei überschreitet die erlaubte Größe")
    return data


def installed_version(target: Path) -> tuple[int, ...]:
    try:
        text = (target / "app.py").read_text(encoding="utf-8")
    except OSError:
        return ()
    match = re.search(r'^__version__\s*=\s*["\'](\d+\.\d+\.\d+)["\']', text, re.M)
    return tuple(int(part) for part in match.group(1).split(".")) if match else ()


def safe_update_root(path: Path) -> bool:
    return path == Path("/var/cache/bitcoin-dashboard-updates") and not path.is_symlink()


def main() -> int:
    if os.geteuid() != 0:
        print("Dieses Programm muss als root laufen", file=sys.stderr)
        return 1

    env = read_env(ENV_FILE)
    config = read_env(UPDATER_CONFIG)
    repository = env.get(
        "DASHBOARD_GITHUB_REPOSITORY", "todo1971/bitcoin-node-dashboard"
    )
    token = env.get("DASHBOARD_GITHUB_TOKEN", "")
    if not re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", repository):
        print("Ungültiges DASHBOARD_GITHUB_REPOSITORY", file=sys.stderr)
        return 1

    update_root = Path(config.get("UPDATE_ROOT", "/var/cache/bitcoin-dashboard-updates"))
    target = Path(config.get("DASHBOARD_TARGET", "/home/btc/bitcoin-dashboard"))
    if not safe_update_root(update_root):
        print("Unsicheres UPDATE_ROOT", file=sys.stderr)
        return 1

    api_base = f"https://api.github.com/repos/{repository}"
    try:
        release = json.loads(
            request_bytes(
                f"{api_base}/releases/latest",
                token,
                "application/vnd.github+json",
                1_000_000,
            )
        )
        tag = str(release["tag_name"])
        latest = version_tuple(tag)
        version = ".".join(str(part) for part in latest)
        current = installed_version(target)
        if current and latest <= current:
            print(f"Dashboard ist bereits aktuell (Version {version})")
            return 20

        archive_name = f"bitcoin-node-dashboard-{version}.tar.gz"
        checksum_name = f"{archive_name}.sha256"
        assets = {
            str(asset.get("name")): str(asset.get("url"))
            for asset in release.get("assets", [])
            if isinstance(asset, dict)
        }
        if archive_name not in assets or checksum_name not in assets:
            raise ValueError(
                f"Release {tag} enthält nicht {archive_name} und {checksum_name}"
            )
        expected_text = request_bytes(
            assets[checksum_name], token, "application/octet-stream", MAX_CHECKSUM_BYTES
        ).decode("ascii", "strict")
        match = re.search(r"\b([0-9a-fA-F]{64})\b", expected_text)
        if not match:
            raise ValueError("Ungültige SHA-256-Datei im GitHub-Release")
        expected = match.group(1).lower()
        archive = request_bytes(
            assets[archive_name], token, "application/octet-stream", MAX_ARCHIVE_BYTES
        )
        actual = hashlib.sha256(archive).hexdigest()
        if actual != expected:
            raise ValueError("SHA-256-Prüfung des GitHub-Releases fehlgeschlagen")

        update_root.mkdir(mode=0o700, parents=True, exist_ok=True)
        destination = update_root / "bitcoin-node-dashboard-update.tar.gz"
        with tempfile.NamedTemporaryFile(dir=update_root, delete=False) as handle:
            temporary = Path(handle.name)
            handle.write(archive)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, 0o600)
        os.replace(temporary, destination)
        print(f"GitHub-Release {tag} heruntergeladen und SHA-256 geprüft")
        return 0
    except (KeyError, ValueError, OSError, json.JSONDecodeError, urllib.error.URLError) as exc:
        print(f"GitHub-Download fehlgeschlagen: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
