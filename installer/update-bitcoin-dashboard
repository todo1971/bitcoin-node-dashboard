set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
umask 077
GUARD=/usr/local/libexec/bitcoin-dashboard-update-guard
test "$#" -eq 0 || { echo "Arguments are not allowed" >&2; exit 1; }

CONFIG=/etc/bitcoin-dashboard-updater.conf
BACKUP_DIR=/var/backups/bitcoin-dashboard

wait_for_health() {
    attempt=0
    while test "$attempt" -lt 30; do
        if systemctl is-active --quiet "$DASHBOARD_SERVICE" && \
           curl --fail --silent --show-error --max-time 3 \
               "$DASHBOARD_HEALTH_URL" >/dev/null 2>&1; then
            return 0
        fi
        attempt=$((attempt + 1))
        sleep 1
    done
    return 1
}

python3 -I "$GUARD" check "$CONFIG"
test -r "$CONFIG" || { echo "Missing $CONFIG" >&2; exit 1; }
. "$CONFIG"
: "${UPDATE_ROOT:=/var/cache/bitcoin-dashboard-updates}"
: "${DASHBOARD_USER:=btc}"
: "${DASHBOARD_TARGET:=/home/btc/bitcoin-dashboard}"
: "${DASHBOARD_SERVICE:=bitcoin-dashboard}"
: "${DASHBOARD_HEALTH_URL:=http://127.0.0.1:8787/healthz}"
test "$UPDATE_ROOT" = /var/cache/bitcoin-dashboard-updates && \
    test -d "$UPDATE_ROOT" && test ! -L "$UPDATE_ROOT" && \
    test "$(stat -c %u "$UPDATE_ROOT")" = 0 && \
    test "$(stat -c %a "$UPDATE_ROOT")" = 700 || {
    echo "Unsafe UPDATE_ROOT" >&2; exit 1;
}
case "$DASHBOARD_USER" in *[!A-Za-z0-9_-]*|'') echo "Invalid dashboard user" >&2; exit 1 ;; esac
case "$DASHBOARD_TARGET" in /home/*/bitcoin-dashboard|/opt/bitcoin-dashboard) ;; *) echo "Unsafe dashboard target" >&2; exit 1 ;; esac
case "$DASHBOARD_SERVICE" in *[!A-Za-z0-9_.@-]*|'') echo "Invalid dashboard service" >&2; exit 1 ;; esac
ARCHIVE="$UPDATE_ROOT/bitcoin-node-dashboard-update.tar.gz"
TARGET="$DASHBOARD_TARGET"
python3 -I "$GUARD" check "$TARGET" "$BACKUP_DIR"
python3 -I "$GUARD" check "$UPDATE_ROOT"
LOCK_FILE="$UPDATE_ROOT/.dashboard-update.lock"


exec 9>"$LOCK_FILE"
flock -n 9 || { echo "Another dashboard update is running" >&2; exit 1; }

if /usr/local/libexec/fetch-bitcoin-dashboard-release; then
    :
else
    fetch_status=$?
    test "$fetch_status" -eq 20 && exit 0
    exit "$fetch_status"
fi

test -f "$ARCHIVE" || { echo "GitHub downloader did not create $ARCHIVE" >&2; exit 1; }

tmp_dir=$(mktemp -d "$UPDATE_ROOT"/dashboard.XXXXXX)
backup=""
qa_dir=""
stage_dir=""
rollback_dir=""
cleanup() {
    result=$?
    if test "$result" -ne 0 && test -n "$rollback_dir" && test -d "$rollback_dir"; then
        systemctl stop "$DASHBOARD_SERVICE" || true
        rm -rf -- "$TARGET"
        mv -- "$rollback_dir" "$TARGET"
        systemctl start "$DASHBOARD_SERVICE" || true
    fi
    test -z "$qa_dir" || rm -rf -- "$qa_dir"
    test -z "$stage_dir" || rm -rf -- "$stage_dir"
    rm -rf -- "$tmp_dir"
}
trap cleanup EXIT
trap 'exit 1' INT TERM

python3 -I "$GUARD" extract "$ARCHIVE" "$tmp_dir" "bitcoin-dashboard" 209715200
source_dir="$tmp_dir/bitcoin-dashboard"
dashboard_group=$(id -gn "$DASHBOARD_USER")
qa_dir=$(mktemp -d /var/tmp/bitcoin-dashboard-qa.XXXXXX)
chgrp "$dashboard_group" "$qa_dir"
chmod 0750 "$qa_dir"
cp -a "$source_dir" "$qa_dir/source"
pycache_dir="$qa_dir/pycache"
install -d -o "$DASHBOARD_USER" -g "$dashboard_group" -m 0700 "$pycache_dir"
if find "$source_dir" -type l -print -quit | grep -q .; then
    echo "Symbolic links are not allowed in dashboard packages" >&2
    exit 1
fi
test -f "$source_dir/app.py" || { echo "app.py missing" >&2; exit 1; }
test -f "$source_dir/static/index.html" || { echo "UI missing" >&2; exit 1; }
test -d "$source_dir/tests" || { echo "Tests missing" >&2; exit 1; }

runuser -u "$DASHBOARD_USER" -- env PYTHONPYCACHEPREFIX="$pycache_dir" \
    sh -c "cd '$qa_dir/source' && python3 -m py_compile app.py && python3 -m unittest discover -s tests -v"
python3 -I "$GUARD" version "$source_dir/app.py"

mkdir -p "$BACKUP_DIR"
if test -d "$TARGET"; then
    backup="$BACKUP_DIR/bitcoin-dashboard-$(date -u +%Y%m%dT%H%M%SZ).tar.gz"
    tar -czf "$backup" -C "$(dirname "$TARGET")" "$(basename "$TARGET")"
fi

stage_dir=$(mktemp -d "$(dirname "$TARGET")/.bitcoin-dashboard-stage.XXXXXX")
cp -a "$source_dir/." "$stage_dir/"
chmod 0755 "$stage_dir"
ln -s /var/lib/bitcoin-dashboard/.env "$stage_dir/.env"
rollback_dir=$(mktemp -d "$(dirname "$TARGET")/.bitcoin-dashboard-previous.XXXXXX")
rmdir "$rollback_dir"
mv -- "$TARGET" "$rollback_dir"
mv -- "$stage_dir" "$TARGET"

systemctl restart "$DASHBOARD_SERVICE"
if ! wait_for_health; then
    echo "Healthcheck failed; rolling back" >&2
    if test -n "$backup"; then
        systemctl stop "$DASHBOARD_SERVICE" || true
        rm -rf -- "$TARGET"
        mv -- "$rollback_dir" "$TARGET"
        systemctl start "$DASHBOARD_SERVICE"
        if ! wait_for_health; then
            echo "Rollback healthcheck failed" >&2
        fi
    fi
    exit 1
fi

rm -rf -- "$rollback_dir"
echo "Dashboard update completed successfully"
python3 -I "$GUARD" version "$TARGET/app.py"
