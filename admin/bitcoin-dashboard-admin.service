[Unit]
Description=Local Bitcoin Dashboard maintenance UI
After=network-online.target bitcoin-dashboard.service
Wants=network-online.target

[Service]
Type=simple
User=deploybot
Group=deploybot
EnvironmentFile=/etc/default/bitcoin-dashboard-admin
ExecStart=/usr/bin/python3 /opt/bitcoin-dashboard-admin/admin_app.py
Restart=on-failure
RestartSec=5
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=-/home -/opt/bitcoin-dashboard -/var/backups/bitcoin-dashboard -/var/backups/bitcoin-core /var/tmp /run/lock
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
