[Unit]
Description=Read-only Bitcoin Core dashboard
After=network-online.target bitcoind.service
Wants=network-online.target

[Service]
Type=simple
User=bitcoin-dashboard
Group=bitcoin-dashboard
WorkingDirectory=/opt/bitcoin-dashboard
EnvironmentFile=/var/lib/bitcoin-dashboard/.env
ExecStart=/usr/bin/python3 -I /opt/bitcoin-dashboard/app.py
Restart=on-failure
RestartSec=5
StateDirectory=bitcoin-dashboard
StateDirectoryMode=0750
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/opt/bitcoin-dashboard
ProtectControlGroups=true
MemoryMax=768M
TasksMax=128

[Install]
WantedBy=multi-user.target
