[Unit]
Description=Read-only Bitcoin Core dashboard
After=network-online.target bitcoind.service
Wants=network-online.target

[Service]
Type=simple
User=btc
Group=btc
WorkingDirectory=/home/btc/bitcoin-dashboard
EnvironmentFile=/var/lib/bitcoin-dashboard/.env
ExecStart=/usr/bin/python3 /home/btc/bitcoin-dashboard/app.py
Restart=on-failure
RestartSec=5
StateDirectory=bitcoin-dashboard
StateDirectoryMode=0750
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/btc/bitcoin-dashboard /home/btc/bitcoin-data /home/btc/bitcoin-core/.bitcoin
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
